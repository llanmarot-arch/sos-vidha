# development | production. In production the server refuses to start unless Supabase,
# an https PUBLIC_SERVER_URL and Twilio are all configured.
NODE_ENV=development

# Server bind port
PORT=3001

# Public URL contacts open from SMS. Required (https) in production.
# Falls back to http://<LAN_IP>:3001 in development when unset.
PUBLIC_SERVER_URL=

# Optional alias (deprecated — use PUBLIC_SERVER_URL)
PUBLIC_BASE_URL=

# Set when running behind a reverse proxy so rate limits see the real client IP (e.g. 1)
TRUST_PROXY=

# 32-byte key as 64 hex characters. Required in production. Encrypts tracker and disarm
# capabilities so an active incident can be restored after a restart. Never log this value.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call this API. Production with an empty
# list blocks cross-origin browsers (native apps are unaffected). Local development
# allows any origin when this is empty.
# CORS_ORIGINS=https://app.example.org,http://localhost:8081
CORS_ORIGINS=

# Supabase (server-only — never expose service role key to the client).
# Both values are required together. If only one is set, the server refuses to start
# rather than running without authentication.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Twilio credentials (server-only)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15551234567
# Optional: enables server-side WhatsApp alerts
TWILIO_WHATSAPP_NUMBER=
# Also place an automated call (no location is spoken; contacts are told to check SMS)
TWILIO_VOICE_ENABLED=true

# Real messages are only sent when Twilio AND Supabase are configured AND either
# NODE_ENV=production or SMS_LIVE_SEND=true. Leave false during development:
# alerts are recorded as dry_run and nothing is sent.
SMS_LIVE_SEND=false

# Alert content
SMS_TIMEZONE=Asia/Kolkata
EMERGENCY_NUMBER=112
# A GPS fix older than this (relative to SOS activation) is labelled STALE
LOCATION_STALE_AFTER_MS=120000
# A fix less accurate than this is labelled LOW ACCURACY
LOCATION_MAX_ACCURACY_M=500
# Reverse-geocoded address is only included when enabled and Mapbox returns one
REVERSE_GEOCODING_ENABLED=false
# Mapbox token: tracking-page tiles and (if enabled) reverse geocoding
MAPBOX_ACCESS_TOKEN=

# Tracking link lifetime (revoked earlier when the SOS is stopped)
TRACKER_TOKEN_TTL_MS=43200000

# Abuse limits
SMS_MAX_RECIPIENTS=5
SMS_MAX_INCIDENTS_PER_HOUR=5
SMS_MAX_ATTEMPTS=3
SMS_RETRY_BASE_MS=2000
SESSION_START_MAX_PER_IP=30
SESSION_START_MAX_PER_USER=10
SESSION_START_WINDOW_MS=600000
# Wrong PIN / disarm-token attempts per session before lockout
DISARM_MAX_ATTEMPTS=8
DISARM_WINDOW_MS=900000

HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_LOST_THRESHOLD_MS=60000
HEARTBEAT_CHECK_INTERVAL_MS=15000
SESSION_CLEANUP_INTERVAL_MS=300000
