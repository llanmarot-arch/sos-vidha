# Server bind port
PORT=3001

# Public URL guardians open from SMS (use ngrok/cloudflare tunnel in dev if needed)
# Falls back to http://<LAN_IP>:3001 when unset
PUBLIC_SERVER_URL=

# Optional alias (deprecated — use PUBLIC_SERVER_URL)
PUBLIC_BASE_URL=

# Mapbox token for guardian tracking dashboard dark tiles
MAPBOX_ACCESS_TOKEN=

# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15551234567

HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_LOST_THRESHOLD_MS=60000
HEARTBEAT_CHECK_INTERVAL_MS=15000
SESSION_CLEANUP_INTERVAL_MS=300000
