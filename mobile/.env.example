EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:3001
EXPO_PUBLIC_SOCKET_URL=http://YOUR_LOCAL_IP:3001

# Local development only: allow mock API when backend is unreachable (never enable in production builds)
EXPO_PUBLIC_ALLOW_MOCK_API=false

# Supabase Auth (public anon key only — safe for client builds)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Route provider — configure at least one
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token
EXPO_PUBLIC_GOOGLE_DIRECTIONS_KEY=your_google_directions_api_key
